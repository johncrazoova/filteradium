{
  "name": "filteradium-ex-client",
  "version": "1.3.0",
  "description": "FilteradiumExClient - استخراج اطلاعات بورس ایران",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.filteradium.exclient",
    "productName": "FilteradiumExClient",
    "win": {
      "target": "portable",
      "icon": "../icon-512.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "gateway/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^9.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
